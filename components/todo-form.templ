package components

templ TodoForm() {
	<div class="bg-white p-6 rounded-lg shadow-sm mb-6">
		<form hx-post="/todos"
		      hx-target="#todo-list"
		      hx-swap="beforeend"
		      hx-trigger="submit"
		      class="flex gap-3">
			<input type="text"
			       name="text"
			       placeholder="Add a new todo..."
			       class="flex-1 px-4 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-transparent"
			       required
			       autocomplete="off"/>
			<button type="submit"
				class="px-6 py-2 bg-indigo-600 hover:bg-indigo-700 text-white font-medium rounded-lg shadow transition-colors duration-200">
				Add
			</button>
		</form>
	</div>
}
